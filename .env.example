# ==============================================
# POS Frontend Environment Variables Example
# ==============================================
# Copy this file to .env and configure values for your environment.
# All environment variables exposed to Vite must start with VITE_.

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Application Name
VITE_APP_NAME=POS Application

# Application Environment (development, staging, production)
VITE_APP_ENV=development

# CSRF Protection Configuration
VITE_CSRF_COOKIE_NAME=pos_csrf
VITE_CSRF_HEADER_NAME=X-CSRF-Token

